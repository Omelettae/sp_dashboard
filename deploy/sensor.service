[Unit]
# Sampling loop. Copy this per sensor script, e.g. sensor-dht22.service and
# sensor-c5a.service, changing ExecStart and SENSOR_CONFIG.
Description=VPD sensor sampling loop
After=network.target sensor-timesync.service
Wants=sensor-timesync.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sp_dashboard/PI Env

# Each script needs its own config file when two run on one Pi. The device
# UUID and the cache are shared on purpose - the cache separates the two by
# its `stream` column.
Environment=SENSOR_CONFIG=config.txt
ExecStart=/home/pi/venv/bin/python3 "/home/pi/sp_dashboard/PI Env/dht22.py"

# SIGTERM is handled in-process: the loop exits, posts a SHUTDOWN device event
# and flushes cleanly. That is what distinguishes "deliberately stopped" from
# "power cut" in DeviceEvent.
KillSignal=SIGTERM
TimeoutStopSec=20

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
